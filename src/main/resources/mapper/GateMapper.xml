<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.tut.cms.server.mapper.GateMapper">

    <update id="updateById">
        UPDATE gate
        <set>
            <if test="gateName != null and gateName != ''">gate_name = #{gateName},</if>
            <if test="gateChiefId != null">gate_chief_id = #{gateChiefId},</if>
            <if test="gateRemark != null">gate_remark = #{gateRemark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectAll" resultType="edu.tut.cms.pojo.vo.GateVO">
        SELECT g.*,
               u.user_name AS chief_name
        FROM gate g
        LEFT JOIN user u ON g.gate_chief_id = u.id
    </select>

</mapper>
